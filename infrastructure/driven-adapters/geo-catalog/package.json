{
  "name": "@earthcation/geo-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptador del catálogo geográfico de Colombia: departamentos y municipios (DANE). Más adelante, también DIVIPOLA con coordenadas.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
