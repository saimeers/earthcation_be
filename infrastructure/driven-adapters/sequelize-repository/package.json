{
  "name": "@earthcation/sequelize-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptador de persistencia: modelos Sequelize, migraciones Umzug y repositorios que implementan los gateways del dominio.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earthcation/model": "workspace:*",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "umzug": "3.8.3"
  }
}
