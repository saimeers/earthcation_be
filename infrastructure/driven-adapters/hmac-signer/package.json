{
  "name": "@earthcation/hmac-signer",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptador que firma los enlaces de vista previa del juego (HMAC-SHA256 en base64url, secreto compartido con el Worker).",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earthcation/model": "workspace:*"
  }
}
