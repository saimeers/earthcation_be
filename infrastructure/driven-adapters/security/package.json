{
  "name": "@earthcation/security",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptador de seguridad: contraseñas con bcrypt, tokens de sesión JWT (HS256), tokens de restablecimiento y contraseñas temporales.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earthcation/model": "workspace:*",
    "bcryptjs": "3.0.3",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10"
  }
}
