{
  "name": "earthcation",
  "version": "1.2.0",
  "private": true,
  "description": "API de Earthcation: monorepo de arquitectura limpia (dominio, casos de uso, adaptadores y app desplegable)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "node applications/app-service/dist/main.js",
    "dev": "pnpm --filter @earthcation/app-service dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise --config .dependency-cruiser.cjs domain infrastructure applications"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-functional": "^10.0.1",
    "globals": "^16.5.0",
    "turbo": "2.11.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
